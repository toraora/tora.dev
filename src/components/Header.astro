---
// import Logo from './Logo.astro'
import Nav from "./Nav.astro";
const { current = "" } = Astro.props;
---

<style>
  header {
    display: flex;
    margin: 0 auto;
    max-width: 46em;
    padding: 2em;
    width: 100%;
  }

  @media (max-width: 480px) {
    header {
      padding: 1.5em 1em;
    }
  }
</style>

<header>
  <Nav current={current} />
</header>
